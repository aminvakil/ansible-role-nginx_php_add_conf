[{{ user_name }}]
user = {{ user_name }}
group = {{ user_name }}
listen = /run/php/{{ user_name }}.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
listen.allowed_clients = 127.0.0.1
pm = static
pm.max_children = 50
pm.start_servers = 5
pm.min_spare_servers = 5
pm.max_spare_servers = 35
slowlog = log/{{ user_name }}.log
chdir = /
php_flag[display_errors] = off
php_value[error_reporting] = 0
;php_admin_value[date.timezone] = {{ timezone }}
php_admin_value[disable_functions] = symlink, virtual, dl, suexec, system, shell_exec, popen, pclose, proc_get_status, proc_nice, proc_terminate, exec, passthru, show_source, escapeshellcmd, escapeshellarg
php_admin_flag[allow_url_fopen] = off
php_admin_value[memory_limit] = 128M
php_admin_value[post_max_size] = 512M
php_admin_value[expose_php] = off
php_admin_value[user_ini.filename] =
php_admin_value[upload_max_filesize] = 512M
php_admin_value[max_file_uploads] = 50
php_admin_value[open_basedir] = /srv/{{ user_name }}/public_html:/srv/{{ user_name }}/tmp
php_value[session.save_handler] = files
php_value[session.save_path] = /srv/{{ user_name }}/tmp/session
php_value[upload_tmp_dir] = /srv/{{ user_name }}/tmp/upload

php_admin_value[opcache.enable] = 1
php_admin_value[opcache.jit_buffer_size] = 100M
php_admin_value[opcache.memory_consumption] = 256M
php_admin_value[opcache.max_accelerated_files] = 16229
php_admin_value[opcache.max_wasted_percentage] = 10
php_admin_value[opcache.validate_timestamps] = 0
php_admin_value[opcache.interned_strings_buffer] = 16
php_admin_value[realpath_cache_size] = 256k
php_admin_value[realpath_cache_ttl] = 300
php_admin_value[mysqlnd.collect_statistics] = off
php_admin_value[mysqlnd.collect_memory_statistics] = off
php_admin_value[output_buffering] = 4096
